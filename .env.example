PORT=3000
API_URL=https://portal.eventscloud.com/api/scan
API_TOKEN=your_token_here
#the oldest scan date I could find was 2026-02-04T14:44:17 to be on safer side I am starting from the beginning of the day
EVENT_START_DATE=2026-02-04T00:00:00.000Z 
POLL_INTERVAL_CRON=*/5 * * * *
DB_PATH=./fankave.db
LOG_LEVEL=info
